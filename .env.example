AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-mini
AZURE_OPENAI_API_VERSION=2024-10-01-preview
AZURE_SPEECH_API=your_azure_speech_api_key
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_ENDPOINT=https://eastus2.api.cognitive.microsoft.com/

twilio_recovery_code=your_twilio_recovery_code
HOSPITAL_NAME=Your Hospital Name
PUBLIC_BASE_URL=https://your-public-url.example.com
VALIDATE_TWILIO_SIGNATURE=true
TWILIO_AUTH_TOKEN=your_twilio_auth_token
VOICE=alloy

MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=YOUR_SERVER;DATABASE=YOUR_DB;UID=YOUR_USER;PWD=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=yes
