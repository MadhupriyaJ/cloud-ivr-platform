# Copy to backend-nestjs/.env (the backend only reads this folder's .env).

# ─────────────────────────────────────────────────────────────
# Azure OpenAI Realtime — the voice brain for web and phone IVR
# ─────────────────────────────────────────────────────────────
# Foundry / Azure OpenAI resource → "Keys and Endpoint".
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# The DEPLOYMENT name you chose (not necessarily the model name).
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-mini
# Speech-to-text for caller transcripts inside the realtime session (optional).
# AZURE_OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Chat model for "Import doctors from the web" (Responses API + web_search).
# The realtime deployment cannot do this; deploy e.g. gpt-5-mini (reasoning
# models can open pages, so they find more doctors) or gpt-4.1-mini.
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# Only if that model lives in another resource/region than the realtime one:
# AZURE_OPENAI_CHAT_ENDPOINT=https://other-resource.openai.azure.com/
# AZURE_OPENAI_CHAT_API_KEY=

# Optional: a chat-completions deployment used by the old keyword hospital IVR
# (/api/hospital/ivr/next) to phrase replies. Without it, fixed replies are used.
# AZURE_OPENAI_ORCHESTRATION_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_ORCHESTRATION_API_VERSION=2024-10-21

# ─────────────────────────────────────────────────────────────
# Azure AI Speech — OPTIONAL. Only for /api/speech/token (browser Speech SDK)
# and the avatar relay token. The realtime voice IVR does not need it.
# ─────────────────────────────────────────────────────────────
AZURE_SPEECH_REGION=
AZURE_SPEECH_API_KEY=

# ─────────────────────────────────────────────────────────────
# Telephony (Twilio) — connects a real phone number to the IVR
# ─────────────────────────────────────────────────────────────
# Public HTTPS URL of THIS backend. Twilio must be able to reach it, and it is
# also used to build the transfer callback when an escalation moves a live call.
# In development use a tunnel, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=https://your-public-url.example.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Number shown to the agent when a call is transferred (must be Twilio-owned).
TWILIO_CALLER_ID=+14155550100
# Reject webhooks that are not signed by Twilio. Leave on outside local testing.
VALIDATE_TWILIO_SIGNATURE=true
# Booking confirmation SMS. Sender defaults to TWILIO_CALLER_ID. Numbers stored
# without a country code get SMS_DEFAULT_COUNTRY_CODE. (India: DLT registration
# is required for SMS to Indian numbers.)
# TWILIO_SMS_FROM=+14155550100
# SMS_DEFAULT_COUNTRY_CODE=+91

# Domain used when an inbound number has not been mapped in Telephony admin.
TELEPHONY_DEFAULT_DOMAIN=hospital
# Last-resort human number when no agent has a direct dial configured.
TELEPHONY_FALLBACK_AGENT_NUMBER=+14155550199

# ─────────────────────────────────────────────────────────────
# IVR content
# ─────────────────────────────────────────────────────────────
HOSPITAL_NAME=Your Hospital Name
VOICE=alloy

# ─────────────────────────────────────────────────────────────
# Database (SQL Server) — either the connection string or the parts
# ─────────────────────────────────────────────────────────────
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USERNAME=sa
MSSQL_PASSWORD=YourStrongPassword123
MSSQL_DATABASE=ivr_platform
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true
# MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=YOUR_SERVER;DATABASE=YOUR_DB;UID=YOUR_USER;PWD=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=yes

# ─────────────────────────────────────────────────────────────
# Servers
# ─────────────────────────────────────────────────────────────
PORT=8010
HOST=0.0.0.0
VITE_FRONTEND_PORT=5170
# Only needed when the built frontend is served from a different origin.
# VITE_BACKEND_HTTP_URL=https://your-public-url.example.com
# VITE_BACKEND_WS_URL=wss://your-public-url.example.com
