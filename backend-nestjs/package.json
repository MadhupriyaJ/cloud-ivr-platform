{
  "name": "generic-ivr-platform-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS scaffold for a generic multi-domain realtime IVR platform",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build": "nest build",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:all": "npm run build:frontend && npm run build",
    "start:all": "npm run build:all && node dist/main",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:all": "node scripts/migrate.mjs ../database/mssql/001_initial_schema.sql ../database/mssql/002_hospital_schema.sql ../database/mssql/002_adapter_integration.sql ../database/mssql/003_hospital_seed.sql ../database/mssql/004_escalation_telephony.sql ../database/mssql/005_multilingual.sql sql/ddl-ivr-engine.sql sql/dml-seed-ivr-engine.sql",
    "test": "npm run build && node test/telephony.test.mjs && node test/escalation-lifecycle.test.mjs && node test/azure-realtime.test.mjs && node test/multilingual.test.mjs && node test/hospital-logic.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
