VITE_APP_NAME=cloud-ivr-platform
VITE_APP_VERSION=9.1.1
GENERATE_SOURCEMAP=false

## JWT auth api (template login pages under /auth/*; not wired to the IVR backend yet)
# global url https://preview.keenthemes.com/hero-api/api
# local url http://127.0.0.1:8000/api
VITE_APP_API_URL=http://127.0.0.1:8000/api

## Backend for the IVR pages. Leave unset when the backend serves this frontend
## (same origin); set both when running `npm run dev` against a separate backend.
# VITE_BACKEND_HTTP_URL=http://localhost:8010
# VITE_BACKEND_WS_URL=ws://localhost:8010/ws
